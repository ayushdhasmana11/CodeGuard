<% layout("/layouts/boilerplate") -%>

<div class="row mt-3">
  <div class="col-8 offset-2">

    <br><br>
    <h3>Submit Your Code</h3>

     <form method="POST" action="/listings" enctype="multipart/form-data" novalidate class="needs-validation">
      <div class="mb-3">
        <label for="studentName" class="form-label">Student Name</label>
        <input
          name="studentName"
          id="studentName"
          placeholder="Enter your full name"
          type="text"
          class="form-control"
          required
        >
      </div>

      <div class="mb-3">
  <label for="rollNumber" class="form-label">Roll Number</label>
  <input
    name="rollNumber"
    id="rollNumber"
    placeholder="Enter your roll number"
    type="number"
    class="form-control"
    min="1"
    step="1"
    required
  >
</div>
      

      <div class="mb-3">
        <label for="assignment" class="form-label">Assignment</label>
        <select
          name="assignment"
          id="assignment"
          class="form-select"
          required
        >
          <option value="" selected disabled>Select assignment</option>
          <option value="Linked List Implementation">Linked List Implementation</option>
          <option value="Sorting Algorithms">Sorting Algorithms</option>
          <option value="Binary Trees">Binary Trees</option>
          <option value="Graph Algorithms">Graph Algorithms</option>
        </select>
      </div>

      <div class="mb-3">
        <label for="language" class="form-label">Programming Language</label>
        <select
          name="language"
          id="language"
          class="form-select"
          required
        >
          <option value="C++">C++</option>
          <option value="C">C</option>
          <option value="Java">Java</option>
        </select>
        
      </div>

      <div class="mb-3">
        <label for="codeFile" class="form-label">Upload Source Code</label>
        <input
          name="codeFile"
          id="codeFile"
          type="file"
          class="form-control"
          accept=".cpp,.c,.java"
          required
        >
        <div class="form-text">
          Upload a .cpp, .c, or .java file. Maximum size: 1 MB.
        </div>
      </div>

      <% if (typeof error !== "undefined" && error) { %>
        <div class="alert alert-danger">
          <%= error %>
        </div>
      <% } %>

      <% if (typeof message !== "undefined" && message) { %>
        <div class="alert alert-success">
          <%= message %>
        </div>
      <% } %>

      <button class="btn btn-dark mt-3" type="submit">
        Submit Code
      </button>

    </form>

  </div>
</div>